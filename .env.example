# Supabase project — Project Settings → API in the Supabase dashboard
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Server
PORT=3000
NODE_ENV=development

# Storage provider: "local" (dev filesystem) or "supabase" (Supabase Storage bucket)
STORAGE_PROVIDER=local

# Only required when STORAGE_PROVIDER=supabase — the bucket name (create it under
# Storage in the Supabase dashboard; keep it Private)
SUPABASE_STORAGE_BUCKET=filey-uploads

# Upload limits
MAX_UPLOAD_SIZE_MB=200
